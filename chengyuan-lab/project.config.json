{
  "description": "澄渊实验室 - 深海分液微信小游戏。appid 请换成正式小游戏 AppID，开发可保持 touristappid。",
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "screenshots" },
      { "type": "folder", "value": "test" },
      { "type": "folder", "value": "scripts" },
      { "type": "folder", "value": "node_modules" },
      { "type": "file", "value": "package.json" },
      { "type": "file", "value": "package-lock.json" },
